  var safeName = String(payload.fileName || 'slip.jpg').replace(/[^A-Za-z0-9._-]/g,'_').slice(-100); var blob = Utilities.newBlob(bytes, mime, order.reference+'-'+safeName); var file = DriveApp.getFolderById(folderId).createFile(blob);
