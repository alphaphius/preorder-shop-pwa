  var lines = payload.lines || []; if (!Array.isArray(lines) || !lines.length) throw apiError_('EMPTY_CART', 'ตะกร้าว่าง');
  var shipping=payload.shipping||{};if(!String(shipping.name||'').trim()||!String(shipping.phone||'').trim()||!String(shipping.address||'').trim())throw apiError_('SHIPPING_REQUIRED','กรุณากรอกข้อมูลจัดส่งให้ครบ');var shippingAgreement=payload.shippingAcceptance||{};var shippingTermsVersion=Number(setting_('shippingTermsVersion',1));if(Number(shippingAgreement.version)!==shippingTermsVersion)throw apiError_('SHIPPING_TERMS_REQUIRED','กรุณาอ่านและกดยอมรับเงื่อนไขการจัดส่งฉบับล่าสุด');var specialTypes=['NONE','REMOTE','TOURIST','ISLAND','OTHER'];shipping.specialAreaType=specialTypes.indexOf(String(shipping.specialAreaType||'NONE'))>=0?String(shipping.specialAreaType||'NONE'):'NONE';shipping.xAccount=String(shipping.xAccount||'').trim().replace(/^@/,'').slice(0,50);
