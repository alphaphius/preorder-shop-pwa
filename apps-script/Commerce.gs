      if (product.type === 'PREORDER') validatePreorder_(product, payload.termsAcceptance);
      normalized.push({ product: product, quantity: quantity }); subtotal += Number(product.price || 0) * quantity; depositDue += (product.type === 'PREORDER' ? Number(product.deposit || 0) : Number(product.price || 0)) * quantity;
    });
    var shippingMode = setting_('shippingMode', 'CART'); var shippingFee = shippingMode === 'ITEM' ? normalized.reduce(function(sum,item){return sum + Number(item.product.shippingFee || 0) * item.quantity;},0) : Number(setting_('cartShippingFee', setting_('shippingFee', 50)));var points=truthy_(setting_('pointsEnabled',true))?Math.floor(Number(payload.redeemPoints||0)):0;var minPoints=Number(setting_('minimumRedeemPoints',100));var perBaht=Number(setting_('pointsPerBaht',10));var maxDiscount=Math.floor(subtotal*Number(setting_('maxRedeemPercent',20))/100);if(points>0&&(points<minPoints||points>Number(context.user.pointsBalance||0)))throw apiError_('INVALID_POINTS','แต้มไม่เพียงพอหรือไม่ถึงขั้นต่ำ');var discount=Math.min(Math.floor(points/perBaht),maxDiscount);points=discount*perBaht; var amountDueNow = Math.max(0,depositDue + shippingFee-discount); var now = new Date(); var expiresAt = new Date(now.getTime() + Number(setting_('reservationMinutes', 20)) * 60000).toISOString(); var orderId = Utilities.getUuid(); var reference = reference_(orderType);
