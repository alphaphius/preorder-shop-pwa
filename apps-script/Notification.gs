function queueJob_(kind,payload){return insert_('JobQueue',{kind:kind,payloadJson:JSON.stringify(payload||{}),state:'QUEUED',attempts:0,nextAttemptAt:new Date().toISOString(),leaseUntil:'',lastError:''});}
function notificationFeed_(context,since){var after=new Date(String(since||0)).getTime()||0;var cursor=new Date().toISOString();var events=[];if(['ADMIN','OWNER'].indexOf(context.user.role)>=0){var orders={};records_('Orders').forEach(function(order){orders[order.id]=order;if(new Date(order.createdAt).getTime()>after)events.push({id:'order:'+order.id,kind:'ORDER_CREATED',titleTh:'มีออเดอร์ใหม่',titleEn:'New order',bodyTh:order.reference+' · ฿'+Number(order.subtotal||0),bodyEn:order.reference+' · THB '+Number(order.subtotal||0),createdAt:order.createdAt});});records_('Payments').forEach(function(payment){if(new Date(payment.createdAt).getTime()>after){var order=orders[payment.orderId]||{};events.push({id:'payment:'+payment.id,kind:'PAYMENT_SUBMITTED',titleTh:'มีสลิปใหม่รอตรวจ',titleEn:'New payment proof',bodyTh:(order.reference||payment.orderId)+' · ฿'+Number(payment.amount||0),bodyEn:(order.reference||payment.orderId)+' · THB '+Number(payment.amount||0),createdAt:payment.createdAt});}});}else{events=records_('Notifications').filter(function(item){return item.userId===context.user.id&&new Date(item.createdAt).getTime()>after;}).map(function(item){return{id:item.id,kind:item.kind,titleTh:item.titleTh,titleEn:item.titleEn,bodyTh:item.bodyTh,bodyEn:item.bodyEn,createdAt:item.createdAt};});}events.sort(function(a,b){return String(a.createdAt).localeCompare(String(b.createdAt));});return{events:events.slice(-50),cursor:cursor};}
function processJobs(){var now=Date.now();var jobs=records_('JobQueue').filter(function(job){return ['QUEUED','RETRY_WAIT'].indexOf(job.state)>=0&&new Date(job.nextAttemptAt||0).getTime()<=now;}).slice(0,10);jobs.forEach(function(job){processJob_(job);});return{processed:jobs.length};}
function processJob_(job){var leaseUntil=new Date(Date.now()+2*60000).toISOString();var leased=update_('JobQueue',job.id,{state:'RUNNING',leaseUntil:leaseUntil,attempts:Number(job.attempts||0)+1});try{var payload=JSON.parse(leased.payloadJson||'{}');sendJobEmail_(leased.kind,payload);update_('JobQueue',leased.id,{state:'SUCCEEDED',leaseUntil:'',lastError:''});}catch(error){var attempts=Number(leased.attempts||0);var failed=attempts>=5;var wait=Math.min(3600,Math.pow(2,attempts)*30)+Math.floor(Math.random()*20);update_('JobQueue',leased.id,{state:failed?'FAILED':'RETRY_WAIT',nextAttemptAt:new Date(Date.now()+wait*1000).toISOString(),leaseUntil:'',lastError:String(error&&error.message||error).slice(0,500)});}}
function sendJobEmail_(kind,payload){var user=findById_('Users',payload.userId);if(!user||!user.email)throw new Error('Recipient missing');var order=payload.orderId&&findById_('Orders',payload.orderId);var subject='อัปเดตจาก '+setting_('storeNameTh','ร้านของฉัน');var body='<p>สวัสดี '+escapeHtml_(user.displayName||user.email)+'</p>';if(order)body+='<p>ออเดอร์ <strong>'+escapeHtml_(order.reference)+'</strong></p>';if(kind==='ORDER_PAYMENT_SUBMITTED')body+='<p>เราได้รับหลักฐานการโอนแล้ว และกำลังตรวจสอบ</p>';else if(kind==='PAYMENT_REVIEWED')body+=payload.approved?'<p>ยืนยันการชำระเงินเรียบร้อยแล้ว</p>':'<p>หลักฐานยังไม่ผ่านการตรวจสอบ: '+escapeHtml_(payload.note||'กรุณาติดต่อร้าน')+'</p>';else if(kind==='ORDER_STATUS_CHANGED')body+='<p>สถานะใหม่: <strong>'+escapeHtml_(payload.status)+'</strong></p><p>'+escapeHtml_(payload.note||'')+'</p>';else if(kind==='ORDER_EXPIRED')body+='<p>ออเดอร์หมดเวลาชำระและสต็อกถูกคืนแล้ว</p>';else if(kind==='ORDER_MESSAGE'){var message=findById_('OrderMessages',payload.messageId);body+='<h3>'+escapeHtml_(message.subjectTh)+'</h3><p>'+escapeHtml_(message.bodyTh).replace(/\n/g,'<br>')+'</p>';}MailApp.sendEmail({to:user.email,subject:subject,htmlBody:body,name:setting_('storeNameEn','Preorder Shop')});}
function jobStatus_(jobId,context){var job=findById_('JobQueue',jobId);if(!job)throw apiError_('JOB_NOT_FOUND','ไม่พบงาน');if(context.user.role==='CUSTOMER'){var payload=JSON.parse(job.payloadJson||'{}');if(payload.userId!==context.user.id)throw apiError_('FORBIDDEN','ไม่มีสิทธิ์ดูงานนี้');}return{id:job.id,kind:job.kind,state:job.state,attempts:Number(job.attempts||0),lastError:context.user.role==='CUSTOMER'?'':job.lastError};}
function escapeHtml_(value){return String(value||'').replace(/[&<>'"]/g,function(char){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char];});}
