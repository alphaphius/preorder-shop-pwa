function connectionTest_(){if(PropertiesService.getScriptProperties().getProperty('SCHEMA_VERSION')!==String(SCHEMA_VERSION))throw apiError_('SCHEMA_NOT_READY','กรุณารัน setupSystem จาก Google Sheet ก่อน');var id='diag-'+Utilities.getUuid();var marker=Utilities.getUuid();var inserted=insert_('Diagnostics',{id:id,marker:marker});var read=findById_('Diagnostics',id);if(!read||read.marker!==marker)throw apiError_('ROUND_TRIP_FAILED','ทดสอบเขียนและอ่านข้อมูลไม่สำเร็จ');deleteRow_('Diagnostics',inserted._row||read._row);return{health:true,schemaVersion:SCHEMA_VERSION,authorization:true,roundTrip:true,serverTime:new Date().toISOString()};}
